/**
 * helper-alarm · Android 实现
 *
 * 原理：
 * 1. AlarmManager 在目标时间点触发一个显式 BroadcastReceiver（AlarmReceiver）
 * 2. Receiver 由系统在 App 进程不存在时也会实例化，所以 App 被杀也能收到
 * 3. 到期提醒弹通知；闹钟额外启动前台服务 AlarmRingService 循环播放闹钟铃声
 * 4. 点击通知通过 PendingIntent 拉起 App，并带上 payload
 *
 * 插件包名由 HBuilderX 按规则生成：uts.sdk.modules.(插件ID转驼峰)
 * 即 uts.sdk.modules.helperAlarm，AndroidManifest.xml 里引用的就是这个名字。
 */
import Context from "android.content.Context"
import Intent from "android.content.Intent"
import Uri from "android.net.Uri"
import AlarmManager from "android.app.AlarmManager"
import PendingIntent from "android.app.PendingIntent"
import BroadcastReceiver from "android.content.BroadcastReceiver"
import Notification from "android.app.Notification"
import NotificationManager from "android.app.NotificationManager"
import NotificationChannel from "android.app.NotificationChannel"
import SharedPreferences from "android.content.SharedPreferences"
import Build from "android.os.Build"
import Settings from "android.provider.Settings"
import PackageManager from "android.content.pm.PackageManager"
import Service from "android.app.Service"
import Activity from "android.app.Activity"
import IBinder from "android.os.IBinder"
import MediaPlayer from "android.media.MediaPlayer"
import AudioManager from "android.media.AudioManager"
import AudioAttributes from "android.media.AudioAttributes"
import RingtoneManager from "android.media.RingtoneManager"
import PowerManager from "android.os.PowerManager"
import Vibrator from "android.os.Vibrator"
import OpenableColumns from "android.provider.OpenableColumns"
import System from "java.lang.System"
import { UTSAndroid } from "io.dcloud.uts"
import { PermissionCallback, RingtonePickCallback } from "../interface.uts"

const CHANNEL_ID : string = "pa_reminder"
const CHANNEL_NAME : string = "到期提醒"
const CHANNEL_DESC : string = "商品使用期限到期提醒"
const RING_CHANNEL_ID : string = "pa_alarm_ring"
const RING_CHANNEL_NAME : string = "闹钟铃声"
const RING_CHANNEL_DESC : string = "闹钟响铃时的前台播放状态"
const EXTRA_PAYLOAD : string = "pa_payload"
const ACTION_FIRE : string = "uts.sdk.modules.helperAlarm.FIRE"
const ACTION_STOP_RING : string = "uts.sdk.modules.helperAlarm.STOP_RING"
const ACTION_SNOOZE_RING : string = "uts.sdk.modules.helperAlarm.SNOOZE_RING"
const ACTION_REQUEST_EXACT_ALARM : string = "android.settings.REQUEST_SCHEDULE_EXACT_ALARM"
const PENDING_FLAGS : number = PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE
const PREFS_NAME : string = "pa_alarm"
const DELIVERED_KEY : string = "delivered_ids"
const DELIVERED_MAX : number = 200
const RING_NOTIFICATION_ID : number = 0x9A01
const RING_TIMEOUT_MS : number = 5 * 60 * 1000
const SNOOZE_MINUTES : number = 5
const RINGTONE_URI_KEY : string = "ringtone_uri"
const RINGTONE_NAME_KEY : string = "ringtone_name"
const PICK_RINGTONE_REQUEST : number = 0x9A02
const PREVIEW_TIMEOUT_MS : number = 15 * 1000

/* 闹钟响铃状态：前台服务与 JS 层（打开 App 后关闭铃声）共享 */
let ringActive : boolean = false
let ringAlarmId : string = ""
let ringPlayer : MediaPlayer | null = null
let ringVibrator : Vibrator | null = null
let ringTimeoutTimer : number = -1
let ringVibrationTimer : number = -1
let ringtonePickCallback : RingtonePickCallback | null = null
let ringtonePickHooked : boolean = false

function getPrefs(context : Context) : SharedPreferences {
  return context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
}

/**
 * 记录"已经真正弹出过通知"的排程 id。
 * AlarmManager 触发时 App 进程可能不存在，无法直接写 JS 存储，
 * 所以先落到 SharedPreferences，等下次 App 启动时由 JS 消费并写入去重表。
 */
function appendDelivered(context : Context, id : string) : void {
  if (id.length == 0) return
  const prefs = getPrefs(context)
  const prev = prefs.getString(DELIVERED_KEY, "") ?? ""
  const list = prev.split("\n").filter((s : string) : boolean => s.length > 0)
  if (list.indexOf(id) >= 0) return
  list.push(id)
  const capped = list.length > DELIVERED_MAX ? list.slice(list.length - DELIVERED_MAX) : list
  prefs.edit().putString(DELIVERED_KEY, capped.join("\n")).apply()
}

/** 字符串 → 稳定的正整数 ID（用于 requestCode / notificationId） */
function hashId(id : string) : number {
  let h = 7
  for (let i = 0; i < id.length; i++) {
    // charCodeAt 在 UTS 中返回可空 Number，必须兜底为非空值
    const code = id.charCodeAt(i) ?? 0
    h = (h * 31 + code) % 2147483647
  }
  return h + 1
}

function ensureChannel(context : Context) : void {
  if (Build.VERSION.SDK_INT < 26) return
  const manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
  if (manager.getNotificationChannel(CHANNEL_ID) != null) return
  const channel = new NotificationChannel(CHANNEL_ID, CHANNEL_NAME, NotificationManager.IMPORTANCE_HIGH)
  channel.setDescription(CHANNEL_DESC)
  channel.enableVibration(true)
  manager.createNotificationChannel(channel)
}

function smallIcon(context : Context) : number {
  const res = context.getResources().getIdentifier("ic_stat_pa", "drawable", context.getPackageName())
  if (res != 0) return res
  return context.getApplicationInfo().icon
}

function buildNotification(context : Context, title : string, content : string, payload : string) : Notification {
  ensureChannel(context)

  let builder : Notification.Builder
  if (Build.VERSION.SDK_INT >= 26) {
    builder = new Notification.Builder(context, CHANNEL_ID)
  } else {
    builder = new Notification.Builder(context)
  }

  builder.setContentTitle(title)
  builder.setContentText(content)
  builder.setSmallIcon(smallIcon(context).toInt())
  builder.setAutoCancel(true)
  builder.setDefaults(Notification.DEFAULT_ALL)
  builder.setPriority(Notification.PRIORITY_HIGH)
  builder.setShowWhen(true)

  const launchIntent = context.getPackageManager().getLaunchIntentForPackage(context.getPackageName())
  if (launchIntent != null) {
    launchIntent.putExtra(EXTRA_PAYLOAD, payload)
    launchIntent.setFlags(
      Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP | Intent.FLAG_ACTIVITY_SINGLE_TOP
    )
    const contentIntent = PendingIntent.getActivity(
      context,
      hashId(payload).toInt(),
      launchIntent,
      PENDING_FLAGS.toInt()
    )
    builder.setContentIntent(contentIntent)
  }

  return builder.build()
}

function showNotification(context : Context, id : string, title : string, content : string, payload : string) : void {
  const manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
  manager.notify(hashId(id).toInt(), buildNotification(context, title, content, payload))
}

/* ------------------------------------------------------------------ */
/* 闹钟响铃：前台服务 + 循环铃声 + 震动                                  */
/* ------------------------------------------------------------------ */

function ensureRingChannel(context : Context) : void {
  if (Build.VERSION.SDK_INT < 26) return
  const manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
  if (manager.getNotificationChannel(RING_CHANNEL_ID) != null) return
  const channel = new NotificationChannel(RING_CHANNEL_ID, RING_CHANNEL_NAME, NotificationManager.IMPORTANCE_HIGH)
  channel.setDescription(RING_CHANNEL_DESC)
  // 铃声由 MediaPlayer 自己播放，通知渠道保持静音，避免只响一声通知音
  channel.setSound(null, null)
  channel.enableVibration(false)
  channel.setShowBadge(false)
  manager.createNotificationChannel(channel)
}

/** 从排程 id（alarm:<alarmId>:<at>）里取出闹钟 id */
function alarmIdOf(entryId : string) : string {
  const parts = entryId.split(":")
  if (parts.length >= 2 && (parts[0] == "alarm" || parts[0] == "alarm-snooze")) return parts[1]
  return ""
}

function isAlarmEntry(id : string) : boolean {
  return id.startsWith("alarm:") || id.startsWith("alarm-snooze:")
}

function buildRingNotification(
  context : Context,
  entryId : string,
  title : string,
  content : string,
  payload : string
) : Notification {
  ensureRingChannel(context)

  let builder : Notification.Builder
  if (Build.VERSION.SDK_INT >= 26) {
    builder = new Notification.Builder(context, RING_CHANNEL_ID)
  } else {
    builder = new Notification.Builder(context)
  }

  builder.setContentTitle(title)
  builder.setContentText(content)
  builder.setSmallIcon(smallIcon(context).toInt())
  builder.setOngoing(true)
  builder.setAutoCancel(false)
  builder.setCategory(Notification.CATEGORY_ALARM)
  builder.setPriority(Notification.PRIORITY_MAX)
  builder.setVisibility(Notification.VISIBILITY_PUBLIC)
  builder.setShowWhen(true)
  builder.setOnlyAlertOnce(true)

  const launchIntent = context.getPackageManager().getLaunchIntentForPackage(context.getPackageName())
  if (launchIntent != null) {
    launchIntent.putExtra(EXTRA_PAYLOAD, payload)
    launchIntent.setFlags(
      Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP | Intent.FLAG_ACTIVITY_SINGLE_TOP
    )
    const contentIntent = PendingIntent.getActivity(
      context,
      hashId(entryId).toInt(),
      launchIntent,
      PENDING_FLAGS.toInt()
    )
    builder.setContentIntent(contentIntent)
    // 锁屏 / 灭屏时直接拉起 App，效果接近系统闹钟
    try {
      builder.setFullScreenIntent(contentIntent, true)
    } catch (e) {
      console.log("[helper-alarm] 设置全屏提醒失败: " + e)
    }
  }

  // 通知栏里的「稍后 5 分钟」和「关闭」操作
  const snoozeIntent = new Intent(context, UTSAndroid.getJavaClass(AlarmRingActionReceiver))
  snoozeIntent.setAction(ACTION_SNOOZE_RING)
  snoozeIntent.putExtra("id", entryId)
  snoozeIntent.putExtra("title", title)
  snoozeIntent.putExtra("content", content)
  snoozeIntent.putExtra("payload", payload)
  const snoozePending = PendingIntent.getBroadcast(
    context,
    hashId("snooze:" + entryId).toInt(),
    snoozeIntent,
    PENDING_FLAGS.toInt()
  )

  const stopIntent = new Intent(context, UTSAndroid.getJavaClass(AlarmRingActionReceiver))
  stopIntent.setAction(ACTION_STOP_RING)
  const stopPending = PendingIntent.getBroadcast(
    context,
    hashId("stop:" + entryId).toInt(),
    stopIntent,
    PENDING_FLAGS.toInt()
  )

  builder.addAction(smallIcon(context).toInt(), "稍后 " + SNOOZE_MINUTES + " 分钟", snoozePending)
  builder.addAction(smallIcon(context).toInt(), "关闭", stopPending)
  return builder.build()
}

function stopPlayback() : void {
  const player = ringPlayer
  ringPlayer = null
  if (player == null) return
  try {
    if (player.isPlaying()) player.stop()
  } catch (e) {
    // 已经停止时 stop() 会抛异常，忽略
  }
  try {
    player.release()
  } catch (e) {
    // 忽略释放异常
  }
}

function tryPlayUri(context : Context, uri : Uri | null) : boolean {
  if (uri == null) return false
  const player = new MediaPlayer()
  try {
    const attrs = new AudioAttributes.Builder()
      .setUsage(AudioAttributes.USAGE_ALARM)
      .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
      .build()
    player.setAudioAttributes(attrs)
    player.setDataSource(context, uri)
    player.setLooping(true)
    player.setWakeMode(context, PowerManager.PARTIAL_WAKE_LOCK)
    player.prepare()
    player.start()
    ringPlayer = player
    return true
  } catch (e) {
    console.log("[helper-alarm] 播放铃声失败: " + e)
    try {
      player.release()
    } catch (e2) {
      // 忽略
    }
    return false
  }
}

/** 用户选择的本地铃声；未选择或读取失败时返回 null，回退到系统闹钟铃声 */
function customRingtoneUri(context : Context) : Uri | null {
  try {
    const raw = getPrefs(context).getString(RINGTONE_URI_KEY, "") ?? ""
    if (raw.length == 0) return null
    return Uri.parse(raw)
  } catch (e) {
    return null
  }
}

/** 查询文件显示名，用于设置页展示 */
function queryDisplayName(context : Context, uri : Uri) : string {
  try {
    const cursor = context.getContentResolver().query(uri, null, null, null, null)
    if (cursor != null) {
      try {
        if (cursor.moveToFirst()) {
          const index = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME)
          if (index >= 0) {
            const name = cursor.getString(index)
            if (name != null && name.length > 0) return name
          }
        }
      } finally {
        cursor.close()
      }
    }
  } catch (e) {
    console.log("[helper-alarm] 读取铃声文件名失败: " + e)
  }
  return uri.getLastPathSegment() ?? ""
}

/** 选择前先尝试 prepare 一次，避免选了无法解码的文件 */
function canPlayUri(context : Context, uri : Uri) : boolean {
  const player = new MediaPlayer()
  try {
    player.setDataSource(context, uri)
    player.prepare()
    player.release()
    return true
  } catch (e) {
    try {
      player.release()
    } catch (e2) {
      // 忽略
    }
    return false
  }
}

function setPickResult(status : string, name : string) : void {
  const callback = ringtonePickCallback
  ringtonePickCallback = null
  if (callback != null) callback(status, name)
}

/** 注册一次 Activity 结果监听，用于接收系统文件选择器的返回结果 */
function ensureRingtonePickHook() : void {
  if (ringtonePickHooked) return
  ringtonePickHooked = true
  UTSAndroid.onAppActivityResult((requestCode : Int, resultCode : Int, data : Intent | null) => {
    if (requestCode != PICK_RINGTONE_REQUEST.toInt()) return
    if (resultCode != Activity.RESULT_OK || data == null) {
      setPickResult("cancel", "")
      return
    }
    const uri = data.getData()
    if (uri == null) {
      setPickResult("cancel", "")
      return
    }

    const context = UTSAndroid.getAppContext()
    if (context == null) {
      setPickResult("error", "")
      return
    }

    // 持久化读取权限，App 重启后仍能访问这个文件
    try {
      context.getContentResolver().takePersistableUriPermission(
        uri,
        Intent.FLAG_GRANT_READ_URI_PERMISSION
      )
    } catch (e) {
      console.log("[helper-alarm] 保存铃声读取权限失败: " + e)
    }

    if (!canPlayUri(context, uri)) {
      setPickResult("error", "")
      return
    }

    const name = queryDisplayName(context, uri)
    getPrefs(context).edit()
      .putString(RINGTONE_URI_KEY, uri.toString())
      .putString(RINGTONE_NAME_KEY, name)
      .apply()
    setPickResult("ok", name)
  })
}

function startPlayback(context : Context) : void {
  stopPlayback()

  // 把闹钟音量调到最大，避免铃声被静音或音量过低盖过去
  try {
    const audioManager = context.getSystemService(Context.AUDIO_SERVICE) as AudioManager
    audioManager.setStreamVolume(
      AudioManager.STREAM_ALARM,
      audioManager.getStreamMaxVolume(AudioManager.STREAM_ALARM),
      0
    )
  } catch (e) {
    console.log("[helper-alarm] 调整闹钟音量失败: " + e)
  }

  // 用户选择的本地铃声优先
  if (tryPlayUri(context, customRingtoneUri(context))) return

  // 插件内置铃声：把 pa_ringtone.mp3 / pa_ringtone.mp4 放到 res/raw 即生效
  const rawId = context.getResources().getIdentifier("pa_ringtone", "raw", context.getPackageName())
  if (rawId != 0) {
    const rawUri = Uri.parse("android.resource://" + context.getPackageName() + "/" + rawId)
    if (tryPlayUri(context, rawUri)) return
  }

  // 与系统闹钟一致：使用系统设置的默认闹钟铃声
  if (tryPlayUri(context, RingtoneManager.getActualDefaultRingtoneUri(context, RingtoneManager.TYPE_ALARM))) return
  if (tryPlayUri(context, RingtoneManager.getDefaultUri(RingtoneManager.TYPE_ALARM))) return
  if (tryPlayUri(context, RingtoneManager.getActualDefaultRingtoneUri(context, RingtoneManager.TYPE_RINGTONE))) return
  if (tryPlayUri(context, RingtoneManager.getActualDefaultRingtoneUri(context, RingtoneManager.TYPE_NOTIFICATION))) return
  tryPlayUri(context, RingtoneManager.getDefaultUri(RingtoneManager.TYPE_NOTIFICATION))
}

function stopVibration() : void {
  if (ringVibrationTimer >= 0) {
    clearInterval(ringVibrationTimer)
    ringVibrationTimer = -1
  }
  const vibrator = ringVibrator
  ringVibrator = null
  if (vibrator == null) return
  try {
    vibrator.cancel()
  } catch (e) {
    // 忽略
  }
}

function startVibration(context : Context) : void {
  stopVibration()
  try {
    const vibrator = context.getSystemService(Context.VIBRATOR_SERVICE) as Vibrator
    ringVibrator = vibrator
    const duration = 700
    const pulse = () => {
      const v = ringVibrator
      if (v == null) return
      try {
        v.vibrate(duration.toLong())
      } catch (e) {
        // 忽略：部分设备在免打扰模式下禁止震动
      }
    }
    pulse()
    ringVibrationTimer = setInterval(pulse, 1600)
  } catch (e) {
    console.log("[helper-alarm] 启动震动失败: " + e)
  }
}

function clearRingTimeout() : void {
  if (ringTimeoutTimer >= 0) {
    clearTimeout(ringTimeoutTimer)
    ringTimeoutTimer = -1
  }
}

function scheduleRingTimeout(context : Context) : void {
  clearRingTimeout()
  // 与系统闹钟一样限制最长响铃时间，避免一直响个不停
  ringTimeoutTimer = setTimeout(() => {
    ringTimeoutTimer = -1
    stopRing(context)
  }, RING_TIMEOUT_MS)
}

/** 停止试听；正在响真正的闹钟时不要打断 */
function stopPreviewPlayback() : void {
  if (ringActive) return
  stopPlayback()
  clearRingTimeout()
}

function startRingService(
  context : Context,
  entryId : string,
  title : string,
  content : string,
  payload : string
) : void {
  const intent = new Intent(context, UTSAndroid.getJavaClass(AlarmRingService))
  intent.putExtra("id", entryId)
  intent.putExtra("title", title)
  intent.putExtra("content", content)
  intent.putExtra("payload", payload)
  try {
    if (Build.VERSION.SDK_INT >= 26) {
      context.startForegroundService(intent)
    } else {
      context.startService(intent)
    }
    return
  } catch (e) {
    // Android 12+ 后台启动前台服务可能被限制，退化为进程内直接播放
    console.log("[helper-alarm] 启动闹钟响铃服务失败，改为进程内播放: " + e)
  }

  try {
    ringActive = true
    ringAlarmId = alarmIdOf(entryId)
    const manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
    manager.notify(
      RING_NOTIFICATION_ID.toInt(),
      buildRingNotification(context, entryId, title, content, payload)
    )
    startPlayback(context)
    startVibration(context)
    scheduleRingTimeout(context)
  } catch (e) {
    console.log("[helper-alarm] 进程内播放铃声失败: " + e)
  }
}

/** 停止响铃：停服务、清通知、复位状态。通知栏按钮和 JS 打开 App 时都会调用 */
function stopRing(context : Context) : void {
  try {
    context.stopService(new Intent(context, UTSAndroid.getJavaClass(AlarmRingService)))
  } catch (e) {
    console.log("[helper-alarm] 停止响铃服务失败: " + e)
  }
  try {
    const manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
    manager.cancel(RING_NOTIFICATION_ID.toInt())
  } catch (e) {
    // 忽略
  }
  // 服务可能没启动成功（退化为进程内播放），这里也统一清掉播放器和震动
  stopPlayback()
  stopVibration()
  clearRingTimeout()
  ringActive = false
}

/**
 * 闹钟响铃前台服务。
 * 用前台服务而不是直接在 Receiver 里播放，避免 App 进程被系统回收后铃声中断。
 */
export class AlarmRingService extends Service {
  constructor() {
    super()
  }

  override onBind(intent : Intent) : IBinder | null {
    return null
  }

  override onStartCommand(intent : Intent, flags : Int, startId : Int) : Int {
    const context = this.getApplicationContext()
    const entryId = intent.getStringExtra("id") ?? ""
    const title = intent.getStringExtra("title") ?? "闹钟"
    const content = intent.getStringExtra("content") ?? ""
    const payload = intent.getStringExtra("payload") ?? ""

    ringActive = true
    ringAlarmId = alarmIdOf(entryId)

    try {
      this.startForeground(
        RING_NOTIFICATION_ID.toInt(),
        buildRingNotification(context, entryId, title, content, payload)
      )
    } catch (e) {
      console.log("[helper-alarm] 显示闹钟通知失败: " + e)
    }

    startPlayback(context)
    startVibration(context)
    scheduleRingTimeout(context)
    return Service.START_NOT_STICKY
  }

  override onDestroy() : void {
    ringActive = false
    stopPlayback()
    stopVibration()
    clearRingTimeout()
    try {
      this.stopForeground(true)
    } catch (e) {
      // 忽略
    }
    super.onDestroy()
  }
}

/**
 * 通知栏「关闭 / 稍后」按钮。
 * 稍后提醒直接在原生侧重排一次闹钟，App 不打开也能再响。
 */
export class AlarmRingActionReceiver extends BroadcastReceiver {
  constructor() {
    super()
  }

  override onReceive(context : Context, intent : Intent) : void {
    const action = intent.getAction() ?? ""
    if (action == ACTION_SNOOZE_RING) {
      try {
        const entryId = intent.getStringExtra("id") ?? ""
        const title = intent.getStringExtra("title") ?? "闹钟"
        const content = intent.getStringExtra("content") ?? ""
        const payload = intent.getStringExtra("payload") ?? ""
        const alarmId = alarmIdOf(entryId)
        const at = parseInt((System.currentTimeMillis() + SNOOZE_MINUTES * 60 * 1000).toString(), 10)
        const snoozeId = "alarm-snooze:" + (alarmId.length > 0 ? alarmId : entryId) + ":" + at
        registerAlarm(context, snoozeId, at, title, content, payload, 0)
        saveScheduleMeta(context, snoozeId, at, title, content, payload, 0)
      } catch (e) {
        console.log("[helper-alarm] 稍后提醒失败: " + e)
      }
    }
    stopRing(context)
  }
}

/**
 * 到点触发的广播接收器。
 * 必须无参构造，系统会反射实例化。
 */
export class AlarmReceiver extends BroadcastReceiver {
  constructor() {
    super()
  }

  override onReceive(context : Context, intent : Intent) : void {
    const id = intent.getStringExtra("id") ?? ""
    const title = intent.getStringExtra("title") ?? "商品到期提醒"
    const content = intent.getStringExtra("content") ?? ""
    const payload = intent.getStringExtra("payload") ?? ""
    const repeatDays = intent.getIntExtra("repeatDays", 0)
    // 进程被杀后 UTSAndroid.getAppContext() 可能为空，这里必须用广播自带的 context
    if (!notificationsEnabled(context)) return
    appendDelivered(context, id)
    if (isAlarmEntry(id)) {
      // 闹钟：前台服务循环播放铃声，通知栏提供「关闭 / 稍后」
      startRingService(context, id, title, content, payload)
    } else {
      showNotification(context, id, title, content, payload)
    }

    // 逾期重复：本次弹完后再排下一次，App 不打开也能持续提醒
    if (repeatDays > 0) {
      try {
        const interval = repeatDays.toLong() * 86400000
        const nextAt = parseInt((System.currentTimeMillis() + interval).toString(), 10)
        registerAlarm(context, id, nextAt, title, content, payload, repeatDays)
        saveScheduleMeta(context, id, nextAt, title, content, payload, repeatDays)
      } catch (e) {
        console.log("[helper-alarm] 续排逾期提醒失败: " + e)
      }
    }
  }
}

function notificationsEnabled(context : Context) : boolean {
  const manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
  return manager.areNotificationsEnabled()
}

/* ------------------------------------------------------------------ */
/* 排程持久化：用于重启 / 应用更新后恢复 AlarmManager                    */
/* ------------------------------------------------------------------ */

const SCHEDULE_INDEX_KEY : string = "schedule_ids"

function scheduleKey(id : string, field : string) : string {
  return "s." + id + "." + field
}

function readScheduleIds(prefs : SharedPreferences) : string[] {
  const raw = prefs.getString(SCHEDULE_INDEX_KEY, "") ?? ""
  if (raw.length == 0) return []
  return raw.split("\n").filter((s : string) : boolean => s.length > 0)
}

function saveScheduleMeta(context : Context, id : string, triggerAt : number, title : string, content : string, payload : string, repeatDays : number) : void {
  const prefs = getPrefs(context)
  const ids = readScheduleIds(prefs)
  if (ids.indexOf(id) < 0) ids.push(id)

  prefs.edit()
    .putString(scheduleKey(id, "at"), triggerAt.toLong().toString())
    .putString(scheduleKey(id, "title"), title)
    .putString(scheduleKey(id, "content"), content)
    .putString(scheduleKey(id, "payload"), payload)
    .putString(scheduleKey(id, "repeatDays"), repeatDays.toLong().toString())
    .putString(SCHEDULE_INDEX_KEY, ids.join("\n"))
    .apply()
}

function removeScheduleMeta(context : Context, id : string) : void {
  const prefs = getPrefs(context)
  const ids = readScheduleIds(prefs).filter((s : string) : boolean => s != id)

  prefs.edit()
    .remove(scheduleKey(id, "at"))
    .remove(scheduleKey(id, "title"))
    .remove(scheduleKey(id, "content"))
    .remove(scheduleKey(id, "payload"))
    .remove(scheduleKey(id, "repeatDays"))
    .putString(SCHEDULE_INDEX_KEY, ids.join("\n"))
    .apply()
}

function registerAlarm(context : Context, id : string, triggerAt : number, title : string, content : string, payload : string, repeatDays : number) : void {
  const intent = new Intent(context, UTSAndroid.getJavaClass(AlarmReceiver))
  intent.setAction(ACTION_FIRE)
  intent.putExtra("id", id)
  intent.putExtra("title", title)
  intent.putExtra("content", content)
  intent.putExtra("payload", payload)
  intent.putExtra("repeatDays", repeatDays.toInt())

  const pendingIntent = PendingIntent.getBroadcast(
    context,
    hashId(id).toInt(),
    intent,
    PENDING_FLAGS.toInt()
  )
  const alarmManager = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager

  try {
    // Android 12+ 未授予精确闹钟权限时会抛 SecurityException，降级为非精确闹钟
    alarmManager.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, triggerAt.toLong(), pendingIntent)
  } catch (e) {
    console.log("[helper-alarm] 精确闹钟不可用，降级: " + e)
    alarmManager.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, triggerAt.toLong(), pendingIntent)
  }
}

function cancelAlarm(context : Context, id : string) : void {
  const intent = new Intent(context, UTSAndroid.getJavaClass(AlarmReceiver))
  intent.setAction(ACTION_FIRE)
  const pendingIntent = PendingIntent.getBroadcast(
    context,
    hashId(id).toInt(),
    intent,
    PENDING_FLAGS.toInt()
  )
  const alarmManager = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
  alarmManager.cancel(pendingIntent)
  pendingIntent.cancel()
}

/** 设备重启后重新注册尚未到期的闹钟，过期的条目顺手清理 */
function restoreSchedules(context : Context) : void {
  const prefs = getPrefs(context)
  const ids = readScheduleIds(prefs)
  const now = parseInt(System.currentTimeMillis().toString(), 10)

  for (const id of ids) {
    let at = parseInt(prefs.getString(scheduleKey(id, "at"), "") ?? "", 10)
    const repeatDays = parseInt(prefs.getString(scheduleKey(id, "repeatDays"), "0") ?? "0", 10)

    if (!(at > 0)) {
      removeScheduleMeta(context, id)
      continue
    }

    if (repeatDays > 0) {
      // 重复提醒：如果错过若干周期，直接推进到下一个未来时间点
      if (at <= now) {
        const interval = repeatDays * 86400000
        const missed = now - at
        at = at + (Math.floor(missed / interval) + 1) * interval
      }
    } else if (at <= now) {
      removeScheduleMeta(context, id)
      continue
    }

    const title = prefs.getString(scheduleKey(id, "title"), "商品到期提醒") ?? "商品到期提醒"
    const content = prefs.getString(scheduleKey(id, "content"), "") ?? ""
    const payload = prefs.getString(scheduleKey(id, "payload"), "") ?? ""
    try {
      registerAlarm(context, id, at, title, content, payload, repeatDays)
      saveScheduleMeta(context, id, at, title, content, payload, repeatDays)
    } catch (e) {
      console.log("[helper-alarm] 恢复排程失败: " + e)
    }
  }
}

/**
 * 开机 / 应用更新后恢复排程。
 * AlarmManager 的闹钟在设备重启后会被系统清空，只靠 App 启动重排会漏提醒。
 */
export class BootReceiver extends BroadcastReceiver {
  constructor() {
    super()
  }

  override onReceive(context : Context, intent : Intent) : void {
    try {
      if (!notificationsEnabled(context)) return
      restoreSchedules(context)
    } catch (e) {
      console.log("[helper-alarm] 开机恢复排程失败: " + e)
    }
  }
}

export function isPermissionGranted() : boolean {
  const context = UTSAndroid.getAppContext()
  if (context == null) return false
  return notificationsEnabled(context)
}

/** Android 12+ 精确闹钟是否已授权；低版本恒为 true */
export function canScheduleExactAlarms() : boolean {
  if (Build.VERSION.SDK_INT < 31) return true
  const context = UTSAndroid.getAppContext()
  if (context == null) return true
  try {
    const alarmManager = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
    return alarmManager.canScheduleExactAlarms()
  } catch (e) {
    return true
  }
}

/** 跳转系统的「闹钟和提醒」授权页 */
export function openExactAlarmSettings() : void {
  if (Build.VERSION.SDK_INT < 31) return
  const context = UTSAndroid.getAppContext()
  if (context == null) return
  try {
    const intent = new Intent(ACTION_REQUEST_EXACT_ALARM)
    intent.setData(Uri.parse("package:" + context.getPackageName()))
    intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
    context.startActivity(intent)
  } catch (e) {
    console.log("[helper-alarm] 打开精确闹钟设置失败: " + e)
  }
}

export function requestPermission(callback : PermissionCallback) : void {
  const context = UTSAndroid.getAppContext()
  const activity = UTSAndroid.getUniActivity()
  if (context == null || activity == null) {
    callback(false)
    return
  }

  if (Build.VERSION.SDK_INT >= 33) {
    const granted = activity.checkSelfPermission("android.permission.POST_NOTIFICATIONS") == PackageManager.PERMISSION_GRANTED
    if (!granted) {
      UTSAndroid.requestSystemPermission(
        activity,
        ["android.permission.POST_NOTIFICATIONS"],
        (allRight : boolean, grantedList : string[]) => {
          callback(allRight && isPermissionGranted())
        },
        (doNotAskAgain : boolean, grantedList : string[]) => {
          callback(false)
        }
      )
      return
    }
  }

  if (isPermissionGranted()) {
    callback(true)
    return
  }

  // 用户已经在系统设置里关掉了通知：跳到本应用的通知设置页
  try {
    let intent : Intent
    if (Build.VERSION.SDK_INT >= 26) {
      intent = new Intent(Settings.ACTION_APP_NOTIFICATION_SETTINGS)
      intent.putExtra(Settings.EXTRA_APP_PACKAGE, context.getPackageName())
    } else {
      intent = new Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS)
      intent.setData(Uri.parse("package:" + context.getPackageName()))
    }
    intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
    context.startActivity(intent)
  } catch (e) {
    console.log("[helper-alarm] 打开通知设置失败: " + e)
  }
  callback(false)
}

export function notifyNow(title : string, content : string, payload : string) : void {
  const context = UTSAndroid.getAppContext()
  if (context == null) return
  const uniqueId = payload + "|" + System.currentTimeMillis().toString()
  showNotification(context, uniqueId, title, content, payload)
}

export function schedule(id : string, triggerAt : number, title : string, content : string, payload : string, repeatDays : number) : void {
  const context = UTSAndroid.getAppContext()
  if (context == null) return

  registerAlarm(context, id, triggerAt, title, content, payload, repeatDays)
  // 持久化一份，供设备重启后由 BootReceiver 恢复
  saveScheduleMeta(context, id, triggerAt, title, content, payload, repeatDays)
}

export function cancel(id : string) : void {
  const context = UTSAndroid.getAppContext()
  if (context == null) return
  cancelAlarm(context, id)
  removeScheduleMeta(context, id)
}

/**
 * 取出并清空原生侧记录的"已送达"排程 id，多个 id 用换行分隔。
 */
export function consumeDeliveredIds() : string {
  const context = UTSAndroid.getAppContext()
  if (context == null) return ""
  const prefs = getPrefs(context)
  const value = prefs.getString(DELIVERED_KEY, "") ?? ""
  if (value.length > 0) prefs.edit().remove(DELIVERED_KEY).apply()
  return value
}

export function consumeLaunchPayload() : string {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) return ""
  const intent = activity.getIntent()
  if (intent == null) return ""
  const payload = intent.getStringExtra(EXTRA_PAYLOAD)
  if (payload == null) return ""
  intent.removeExtra(EXTRA_PAYLOAD)
  return payload
}

/** 当前是否正在响铃 */
export function isRinging() : boolean {
  return ringActive
}

/** 正在响铃的闹钟 id；没有响铃时返回空字符串 */
export function getRingingAlarmId() : string {
  return ringActive ? ringAlarmId : ""
}

/** 打开 App / 用户确认后停止铃声 */
export function stopRinging() : void {
  const context = UTSAndroid.getAppContext()
  if (context == null) return
  stopRing(context)
}

/**
 * 打开系统文件选择器，挑一个本地音频/视频作为闹钟铃声。
 * 通过 SAF 获取持久化读取权限，不申请存储权限。
 */
export function pickRingtone(callback : RingtonePickCallback) : void {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    callback("error", "")
    return
  }

  stopPreviewPlayback()
  ensureRingtonePickHook()
  ringtonePickCallback = callback

  try {
    const intent = new Intent(Intent.ACTION_OPEN_DOCUMENT)
    intent.addCategory(Intent.CATEGORY_OPENABLE)
    // 不限定 MIME：部分文件管理器把 mp4 标成 video/*，限定 audio/* 会选不到
    intent.setType("*/*")
    intent.addFlags(
      Intent.FLAG_GRANT_READ_URI_PERMISSION | Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION
    )
    activity.startActivityForResult(intent, PICK_RINGTONE_REQUEST.toInt())
  } catch (e) {
    console.log("[helper-alarm] 打开铃声选择器失败: " + e)
    ringtonePickCallback = null
    callback("error", "")
  }
}

/** 当前本地铃声的显示名；空字符串表示使用系统闹钟铃声 */
export function getRingtoneName() : string {
  const context = UTSAndroid.getAppContext()
  if (context == null) return ""
  return getPrefs(context).getString(RINGTONE_NAME_KEY, "") ?? ""
}

/** 恢复系统默认闹钟铃声，并释放本地文件的读取权限 */
export function clearRingtone() : void {
  const context = UTSAndroid.getAppContext()
  if (context == null) return
  stopPreviewPlayback()
  const prefs = getPrefs(context)
  const raw = prefs.getString(RINGTONE_URI_KEY, "") ?? ""
  if (raw.length > 0) {
    try {
      context.getContentResolver().releasePersistableUriPermission(
        Uri.parse(raw),
        Intent.FLAG_GRANT_READ_URI_PERMISSION
      )
    } catch (e) {
      // 权限可能已失效，忽略
    }
  }
  prefs.edit().remove(RINGTONE_URI_KEY).remove(RINGTONE_NAME_KEY).apply()
}

/** 试听当前铃声，15 秒后自动停止 */
export function previewRingtone() : void {
  const context = UTSAndroid.getAppContext()
  if (context == null || ringActive) return
  startPlayback(context)
  clearRingTimeout()
  ringTimeoutTimer = setTimeout(() => {
    ringTimeoutTimer = -1
    stopPlayback()
  }, PREVIEW_TIMEOUT_MS)
}
