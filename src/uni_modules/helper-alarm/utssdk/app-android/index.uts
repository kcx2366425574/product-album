/**
 * helper-alarm · Android 实现
 *
 * 原理：
 * 1. AlarmManager 在目标时间点触发一个显式 BroadcastReceiver（AlarmReceiver）
 * 2. Receiver 由系统在 App 进程不存在时也会实例化，所以 App 被杀也能收到
 * 3. Receiver 内用 NotificationManager 弹出通知栏消息
 * 4. 点击通知通过 PendingIntent 拉起 App，并带上 payload
 *
 * 插件包名由 HBuilderX 按规则生成：uts.sdk.modules.(插件ID转驼峰)
 * 即 uts.sdk.modules.helperAlarm，AndroidManifest.xml 里引用的就是这个名字。
 */
import Context from "android.content.Context"
import Intent from "android.content.Intent"
import Uri from "android.net.Uri"
import AlarmManager from "android.app.AlarmManager"
import PendingIntent from "android.app.PendingIntent"
import BroadcastReceiver from "android.content.BroadcastReceiver"
import Notification from "android.app.Notification"
import NotificationManager from "android.app.NotificationManager"
import NotificationChannel from "android.app.NotificationChannel"
import SharedPreferences from "android.content.SharedPreferences"
import Build from "android.os.Build"
import Settings from "android.provider.Settings"
import PackageManager from "android.content.pm.PackageManager"
import System from "java.lang.System"
import { UTSAndroid } from "io.dcloud.uts"
import { PermissionCallback } from "../interface.uts"

const CHANNEL_ID : string = "pa_reminder"
const CHANNEL_NAME : string = "到期提醒"
const CHANNEL_DESC : string = "商品使用期限到期提醒"
const EXTRA_PAYLOAD : string = "pa_payload"
const ACTION_FIRE : string = "uts.sdk.modules.helperAlarm.FIRE"
const ACTION_REQUEST_EXACT_ALARM : string = "android.settings.REQUEST_SCHEDULE_EXACT_ALARM"
const PENDING_FLAGS : number = PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE
const PREFS_NAME : string = "pa_alarm"
const DELIVERED_KEY : string = "delivered_ids"
const DELIVERED_MAX : number = 200

function getPrefs(context : Context) : SharedPreferences {
  return context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
}

/**
 * 记录"已经真正弹出过通知"的排程 id。
 * AlarmManager 触发时 App 进程可能不存在，无法直接写 JS 存储，
 * 所以先落到 SharedPreferences，等下次 App 启动时由 JS 消费并写入去重表。
 */
function appendDelivered(context : Context, id : string) : void {
  if (id.length == 0) return
  const prefs = getPrefs(context)
  const prev = prefs.getString(DELIVERED_KEY, "") ?? ""
  const list = prev.split("\n").filter((s : string) : boolean => s.length > 0)
  if (list.indexOf(id) >= 0) return
  list.push(id)
  const capped = list.length > DELIVERED_MAX ? list.slice(list.length - DELIVERED_MAX) : list
  prefs.edit().putString(DELIVERED_KEY, capped.join("\n")).apply()
}

/** 字符串 → 稳定的正整数 ID（用于 requestCode / notificationId） */
function hashId(id : string) : number {
  let h = 7
  for (let i = 0; i < id.length; i++) {
    h = (h * 31 + id.charCodeAt(i)) % 2147483647
  }
  return h + 1
}

function ensureChannel(context : Context) : void {
  if (Build.VERSION.SDK_INT < 26) return
  const manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
  if (manager.getNotificationChannel(CHANNEL_ID) != null) return
  const channel = new NotificationChannel(CHANNEL_ID, CHANNEL_NAME, NotificationManager.IMPORTANCE_HIGH)
  channel.setDescription(CHANNEL_DESC)
  channel.enableVibration(true)
  manager.createNotificationChannel(channel)
}

function smallIcon(context : Context) : number {
  const res = context.getResources().getIdentifier("ic_stat_pa", "drawable", context.getPackageName())
  if (res != 0) return res
  return context.getApplicationInfo().icon
}

function buildNotification(context : Context, title : string, content : string, payload : string) : Notification {
  ensureChannel(context)

  let builder : Notification.Builder
  if (Build.VERSION.SDK_INT >= 26) {
    builder = new Notification.Builder(context, CHANNEL_ID)
  } else {
    builder = new Notification.Builder(context)
  }

  builder.setContentTitle(title)
  builder.setContentText(content)
  builder.setSmallIcon(smallIcon(context).toInt())
  builder.setAutoCancel(true)
  builder.setDefaults(Notification.DEFAULT_ALL)
  builder.setPriority(Notification.PRIORITY_HIGH)
  builder.setShowWhen(true)

  const launchIntent = context.getPackageManager().getLaunchIntentForPackage(context.getPackageName())
  if (launchIntent != null) {
    launchIntent.putExtra(EXTRA_PAYLOAD, payload)
    launchIntent.setFlags(
      Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP | Intent.FLAG_ACTIVITY_SINGLE_TOP
    )
    const contentIntent = PendingIntent.getActivity(
      context,
      hashId(payload).toInt(),
      launchIntent,
      PENDING_FLAGS.toInt()
    )
    builder.setContentIntent(contentIntent)
  }

  return builder.build()
}

function showNotification(context : Context, id : string, title : string, content : string, payload : string) : void {
  const manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
  manager.notify(hashId(id).toInt(), buildNotification(context, title, content, payload))
}

/**
 * 到点触发的广播接收器。
 * 必须无参构造，系统会反射实例化。
 */
export class AlarmReceiver extends BroadcastReceiver {
  constructor() {
    super()
  }

  override onReceive(context : Context, intent : Intent) : void {
    const id = intent.getStringExtra("id") ?? ""
    const title = intent.getStringExtra("title") ?? "商品到期提醒"
    const content = intent.getStringExtra("content") ?? ""
    const payload = intent.getStringExtra("payload") ?? ""
    const repeatDays = intent.getIntExtra("repeatDays", 0)
    // 进程被杀后 UTSAndroid.getAppContext() 可能为空，这里必须用广播自带的 context
    if (!notificationsEnabled(context)) return
    appendDelivered(context, id)
    showNotification(context, id, title, content, payload)

    // 逾期重复：本次弹完后再排下一次，App 不打开也能持续提醒
    if (repeatDays > 0) {
      try {
        const interval = repeatDays.toLong() * 86400000
        const nextAt = parseInt((System.currentTimeMillis() + interval).toString(), 10)
        registerAlarm(context, id, nextAt, title, content, payload, repeatDays)
        saveScheduleMeta(context, id, nextAt, title, content, payload, repeatDays)
      } catch (e) {
        console.log("[helper-alarm] 续排逾期提醒失败: " + e)
      }
    }
  }
}

function notificationsEnabled(context : Context) : boolean {
  const manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
  return manager.areNotificationsEnabled()
}

/* ------------------------------------------------------------------ */
/* 排程持久化：用于重启 / 应用更新后恢复 AlarmManager                    */
/* ------------------------------------------------------------------ */

const SCHEDULE_INDEX_KEY : string = "schedule_ids"

function scheduleKey(id : string, field : string) : string {
  return "s." + id + "." + field
}

function readScheduleIds(prefs : SharedPreferences) : string[] {
  const raw = prefs.getString(SCHEDULE_INDEX_KEY, "") ?? ""
  if (raw.length == 0) return []
  return raw.split("\n").filter((s : string) : boolean => s.length > 0)
}

function saveScheduleMeta(context : Context, id : string, triggerAt : number, title : string, content : string, payload : string, repeatDays : number) : void {
  const prefs = getPrefs(context)
  const ids = readScheduleIds(prefs)
  if (ids.indexOf(id) < 0) ids.push(id)

  prefs.edit()
    .putString(scheduleKey(id, "at"), triggerAt.toLong().toString())
    .putString(scheduleKey(id, "title"), title)
    .putString(scheduleKey(id, "content"), content)
    .putString(scheduleKey(id, "payload"), payload)
    .putString(scheduleKey(id, "repeatDays"), repeatDays.toLong().toString())
    .putString(SCHEDULE_INDEX_KEY, ids.join("\n"))
    .apply()
}

function removeScheduleMeta(context : Context, id : string) : void {
  const prefs = getPrefs(context)
  const ids = readScheduleIds(prefs).filter((s : string) : boolean => s != id)

  prefs.edit()
    .remove(scheduleKey(id, "at"))
    .remove(scheduleKey(id, "title"))
    .remove(scheduleKey(id, "content"))
    .remove(scheduleKey(id, "payload"))
    .remove(scheduleKey(id, "repeatDays"))
    .putString(SCHEDULE_INDEX_KEY, ids.join("\n"))
    .apply()
}

function registerAlarm(context : Context, id : string, triggerAt : number, title : string, content : string, payload : string, repeatDays : number) : void {
  const intent = new Intent(context, UTSAndroid.getJavaClass(AlarmReceiver))
  intent.setAction(ACTION_FIRE)
  intent.putExtra("id", id)
  intent.putExtra("title", title)
  intent.putExtra("content", content)
  intent.putExtra("payload", payload)
  intent.putExtra("repeatDays", repeatDays.toInt())

  const pendingIntent = PendingIntent.getBroadcast(
    context,
    hashId(id).toInt(),
    intent,
    PENDING_FLAGS.toInt()
  )
  const alarmManager = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager

  try {
    // Android 12+ 未授予精确闹钟权限时会抛 SecurityException，降级为非精确闹钟
    alarmManager.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, triggerAt.toLong(), pendingIntent)
  } catch (e) {
    console.log("[helper-alarm] 精确闹钟不可用，降级: " + e)
    alarmManager.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, triggerAt.toLong(), pendingIntent)
  }
}

function cancelAlarm(context : Context, id : string) : void {
  const intent = new Intent(context, UTSAndroid.getJavaClass(AlarmReceiver))
  intent.setAction(ACTION_FIRE)
  const pendingIntent = PendingIntent.getBroadcast(
    context,
    hashId(id).toInt(),
    intent,
    PENDING_FLAGS.toInt()
  )
  const alarmManager = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
  alarmManager.cancel(pendingIntent)
  pendingIntent.cancel()
}

/** 设备重启后重新注册尚未到期的闹钟，过期的条目顺手清理 */
function restoreSchedules(context : Context) : void {
  const prefs = getPrefs(context)
  const ids = readScheduleIds(prefs)
  const now = parseInt(System.currentTimeMillis().toString(), 10)

  for (const id of ids) {
    let at = parseInt(prefs.getString(scheduleKey(id, "at"), "") ?? "", 10)
    const repeatDays = parseInt(prefs.getString(scheduleKey(id, "repeatDays"), "0") ?? "0", 10)

    if (!(at > 0)) {
      removeScheduleMeta(context, id)
      continue
    }

    if (repeatDays > 0) {
      // 重复提醒：如果错过若干周期，直接推进到下一个未来时间点
      if (at <= now) {
        const interval = repeatDays * 86400000
        const missed = now - at
        at = at + (Math.floor(missed / interval) + 1) * interval
      }
    } else if (at <= now) {
      removeScheduleMeta(context, id)
      continue
    }

    const title = prefs.getString(scheduleKey(id, "title"), "商品到期提醒") ?? "商品到期提醒"
    const content = prefs.getString(scheduleKey(id, "content"), "") ?? ""
    const payload = prefs.getString(scheduleKey(id, "payload"), "") ?? ""
    try {
      registerAlarm(context, id, at, title, content, payload, repeatDays)
      saveScheduleMeta(context, id, at, title, content, payload, repeatDays)
    } catch (e) {
      console.log("[helper-alarm] 恢复排程失败: " + e)
    }
  }
}

/**
 * 开机 / 应用更新后恢复排程。
 * AlarmManager 的闹钟在设备重启后会被系统清空，只靠 App 启动重排会漏提醒。
 */
export class BootReceiver extends BroadcastReceiver {
  constructor() {
    super()
  }

  override onReceive(context : Context, intent : Intent) : void {
    try {
      if (!notificationsEnabled(context)) return
      restoreSchedules(context)
    } catch (e) {
      console.log("[helper-alarm] 开机恢复排程失败: " + e)
    }
  }
}

export function isPermissionGranted() : boolean {
  const context = UTSAndroid.getAppContext()
  if (context == null) return false
  return notificationsEnabled(context)
}

/** Android 12+ 精确闹钟是否已授权；低版本恒为 true */
export function canScheduleExactAlarms() : boolean {
  if (Build.VERSION.SDK_INT < 31) return true
  const context = UTSAndroid.getAppContext()
  if (context == null) return true
  try {
    const alarmManager = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
    return alarmManager.canScheduleExactAlarms()
  } catch (e) {
    return true
  }
}

/** 跳转系统的「闹钟和提醒」授权页 */
export function openExactAlarmSettings() : void {
  if (Build.VERSION.SDK_INT < 31) return
  const context = UTSAndroid.getAppContext()
  if (context == null) return
  try {
    const intent = new Intent(ACTION_REQUEST_EXACT_ALARM)
    intent.setData(Uri.parse("package:" + context.getPackageName()))
    intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
    context.startActivity(intent)
  } catch (e) {
    console.log("[helper-alarm] 打开精确闹钟设置失败: " + e)
  }
}

export function requestPermission(callback : PermissionCallback) : void {
  const context = UTSAndroid.getAppContext()
  const activity = UTSAndroid.getUniActivity()
  if (context == null || activity == null) {
    callback(false)
    return
  }

  if (Build.VERSION.SDK_INT >= 33) {
    const granted = activity.checkSelfPermission("android.permission.POST_NOTIFICATIONS") == PackageManager.PERMISSION_GRANTED
    if (!granted) {
      UTSAndroid.requestSystemPermission(
        activity,
        ["android.permission.POST_NOTIFICATIONS"],
        (allRight : boolean, grantedList : string[]) => {
          callback(allRight && isPermissionGranted())
        },
        (doNotAskAgain : boolean, grantedList : string[]) => {
          callback(false)
        }
      )
      return
    }
  }

  if (isPermissionGranted()) {
    callback(true)
    return
  }

  // 用户已经在系统设置里关掉了通知：跳到本应用的通知设置页
  try {
    let intent : Intent
    if (Build.VERSION.SDK_INT >= 26) {
      intent = new Intent(Settings.ACTION_APP_NOTIFICATION_SETTINGS)
      intent.putExtra(Settings.EXTRA_APP_PACKAGE, context.getPackageName())
    } else {
      intent = new Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS)
      intent.setData(Uri.parse("package:" + context.getPackageName()))
    }
    intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
    context.startActivity(intent)
  } catch (e) {
    console.log("[helper-alarm] 打开通知设置失败: " + e)
  }
  callback(false)
}

export function notifyNow(title : string, content : string, payload : string) : void {
  const context = UTSAndroid.getAppContext()
  if (context == null) return
  const uniqueId = payload + "|" + System.currentTimeMillis().toString()
  showNotification(context, uniqueId, title, content, payload)
}

export function schedule(id : string, triggerAt : number, title : string, content : string, payload : string, repeatDays : number) : void {
  const context = UTSAndroid.getAppContext()
  if (context == null) return

  registerAlarm(context, id, triggerAt, title, content, payload, repeatDays)
  // 持久化一份，供设备重启后由 BootReceiver 恢复
  saveScheduleMeta(context, id, triggerAt, title, content, payload, repeatDays)
}

export function cancel(id : string) : void {
  const context = UTSAndroid.getAppContext()
  if (context == null) return
  cancelAlarm(context, id)
  removeScheduleMeta(context, id)
}

/**
 * 取出并清空原生侧记录的"已送达"排程 id，多个 id 用换行分隔。
 */
export function consumeDeliveredIds() : string {
  const context = UTSAndroid.getAppContext()
  if (context == null) return ""
  const prefs = getPrefs(context)
  const value = prefs.getString(DELIVERED_KEY, "") ?? ""
  if (value.length > 0) prefs.edit().remove(DELIVERED_KEY).apply()
  return value
}

export function consumeLaunchPayload() : string {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) return ""
  const intent = activity.getIntent()
  if (intent == null) return ""
  const payload = intent.getStringExtra(EXTRA_PAYLOAD)
  if (payload == null) return ""
  intent.removeExtra(EXTRA_PAYLOAD)
  return payload
}
